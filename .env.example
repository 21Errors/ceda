# =============================================================================
# CEDA Innovation Management Portal — Environment Variable Template
# Copy this file to .env.local for local development.
# Never commit .env or .env.local with real credentials.
# =============================================================================

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
NEON_BRANCH_ID=""

# --- Authentication (Better Auth & WebAuthn Passkeys) ---
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:3000"

# --- Initial Administrator Bootstrap ---
CEDA_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"

# --- Transactional Email (Gmail SMTP / Google Workspace) ---
# Leave blank in local development to log OTP codes to the server console.
# Required in production (fails closed if omitted).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Neon Object Storage (S3-compatible uploads bucket) ---
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
